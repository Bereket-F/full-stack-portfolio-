DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?schema=public"
PORT=4000
NODE_ENV=development

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN=7d
COOKIE_NAME=portfolio_token
# lax works when frontend+backend share a domain (e.g. local dev on localhost).
# Use "none" when they're on different domains in production (requires HTTPS).
COOKIE_SAMESITE=lax

# Comma-separated list of exact trusted frontend origins. Never use a wildcard.
CORS_ORIGIN=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

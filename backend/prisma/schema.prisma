// Prisma schema for the portfolio backend.
// Run `npx prisma migrate dev --name init` after editing this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum SkillCategory {
  FRONTEND
  BACKEND
  DATABASE
  TESTING
  DESIGN
  OTHER
}

enum ProjectCategory {
  WEB
  API
  MOBILE
  TESTING
  TOOLING
  OTHER
}

/// The single admin account that can log into /admin.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  /// Bumped on logout/password change to invalidate previously-issued JWTs server-side.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Singleton row holding the public "About / Hero" content, editable from Settings > General.
model Profile {
  id             String       @id @default(cuid())
  name           String
  role           String
  tagline        String
  bio            String
  location       String?
  email          String?
  avatarUrl      String?
  resumeUrl      String?
  seoTitle       String?
  seoDescription String?
  socialLinks    SocialLink[]
  updatedAt      DateTime     @updatedAt
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String // e.g. "github", "linkedin", "twitter"
  url       String
  order     Int      @default(0)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
}

model Skill {
  id        String        @id @default(cuid())
  name      String
  category  SkillCategory
  level     Int           @default(80) // 0-100, used for progress bars
  icon      String? // icon key resolved on the frontend
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([category])
}

model Technology {
  id       String              @id @default(cuid())
  name     String              @unique
  projects ProjectTechnology[]
}

model Project {
  id            String              @id @default(cuid())
  title         String
  slug          String              @unique
  summary       String
  overview      String?
  problem       String?
  solution      String?
  role          String?
  challenges    String?
  features      String[] // stored as text[] in Postgres
  coverImage    String?
  screenshots   String[]
  githubUrl     String?
  demoUrl       String?
  category      ProjectCategory     @default(WEB)
  featured      Boolean             @default(false)
  published     Boolean             @default(true)
  order         Int                 @default(0)
  technologies  ProjectTechnology[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([slug])
  @@index([featured])
}

model ProjectTechnology {
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  technologyId String

  @@id([projectId, technologyId])
}

model Experience {
  id               String    @id @default(cuid())
  company          String
  position         String
  location         String?
  startDate        DateTime
  endDate          DateTime?
  current          Boolean   @default(false)
  description       String
  responsibilities String[]
  technologies      String[]
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Education {
  id          String    @id @default(cuid())
  institution String
  degree      String
  field       String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BlogPost {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?
  coverImage    String?
  content       String
  status        PostStatus    @default(DRAFT)
  publishedAt   DateTime?
  tags          BlogPostTag[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([slug])
  @@index([status])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model BlogTag {
  id    String        @id @default(cuid())
  name  String        @unique
  posts BlogPostTag[]
}

model BlogPostTag {
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@id([postId, tagId])
}

model Message {
  id         String   @id @default(cuid())
  name       String
  email      String
  subject    String
  message    String
  read       Boolean  @default(false)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([read])
  @@index([archived])
}
